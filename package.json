{
  "name": "aegis-cli",
  "version": "0.1.0",
  "description": "ANSDLC 2.0 workflow guide — your command center for AI-assisted development",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aegis": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ansdlc",
    "claude-code",
    "ai-workflow",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "chalk": "^5.6.2",
    "boxen": "^8.0.1",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1",
    "@inquirer/prompts": "^8.5.2",
    "figlet": "^1.11.0",
    "@11ty/gray-matter": "^7.0.0",
    "tinyglobby": "^0.2.17",
    "conf": "^15.1.0",
    "is-unicode-supported": "^2.1.0",
    "supports-color": "^10.2.2",
    "supports-hyperlinks": "^4.4.0",
    "terminal-size": "^4.0.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0",
    "prettier": "^3.9.0",
    "eslint": "^10.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.0.0"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "target": "node22",
    "platform": "node"
  }
}
